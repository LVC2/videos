[Unit]
Description=Video Core media server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=videos
Group=videos
WorkingDirectory=/opt/videos
ExecStart=/opt/videos/video-core
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/videos/runtime

[Install]
WantedBy=multi-user.target
